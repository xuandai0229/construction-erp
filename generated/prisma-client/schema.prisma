generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  ACCOUNTANT
  VIEWER
}

enum SubcontractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  COMPLETED
  TERMINATED
}

enum InventoryTransactionType {
  RECEIPT // From PO (GRN)
  ISSUE // To Site
  RETURN // From Site to Warehouse
  ADJUST // For stock count
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ACTIVE
  COMPLETED
  CLOSED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum CostType {
  material
  labor
  machine
  subcontract
  overhead
  other
}

enum PaymentStatus {
  paid
  unpaid
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum TransactionType {
  DEBIT
  CREDIT
}

// NEW ENUMS
enum ProcurementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  AMENDED
  COMPLETED
  TERMINATED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  role      UserRole  @default(VIEWER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projectsOwned   Project[]      @relation("ProjectOwner")
  tasksAssigned   Task[]
  costsCreated    CostRecord[]   @relation("CostCreatedBy")
  budgetsCreated  BudgetRecord[] @relation("BudgetCreatedBy")
  revenuesCreated Revenue[]      @relation("RevenueCreatedBy")
  invoicesCreated Invoice[]      @relation("InvoiceCreatedBy")
  auditLogs       AuditLog[]

  purchaseRequestsCreated PurchaseRequest[]  @relation("PRCreatedBy")
  purchaseOrdersCreated   PurchaseOrder[]    @relation("POCreatedBy")
  contractsCreated        Contract[]         @relation("ContractCreatedBy")
  approvalRequests        ApprovalRequest[]  @relation("RequestRequester")
  approvalSteps           ApprovalStep[]     @relation("StepApprover")
  lockedPeriods           FiscalPeriod[]     @relation("PeriodLockedBy")
  progressCreated         ProgressEntry[]    @relation("ProgressCreatedBy")
  comments                Comment[]
  activityFeeds           ActivityFeed[]
  documentsUploaded       Document[]
  delegationsOwned        DelegationWindow[] @relation("DelegationOwner")
  delegationsActive       DelegationWindow[] @relation("DelegationDelegate")
  trainingRecords         TrainingRecord[]
  maturity                UserMaturity?

  @@index([createdAt])
}

model AuthorityMatrix {
  id          String   @id @default(uuid())
  role        UserRole
  maxAmount   Decimal  @db.Decimal(18, 2)
  entityType  String // e.g. "PURCHASE_ORDER", "INVOICE", "CONTRACT"
  projectType String? // Optional: override by project type
  priority    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingRecord {
  id          String    @id @default(uuid())
  userId      String
  title       String
  module      String?
  status      String    @default("ASSIGNED")
  score       Decimal?  @db.Decimal(5, 2)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model UserMaturity {
  id             String   @id @default(uuid())
  userId         String   @unique
  accuracy       Decimal  @default(100) @db.Decimal(5, 2)
  maturityLevel  String   @default("BEGINNER")
  lastAssessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model DelegationPolicy {
  id       String  @id @default(uuid())
  name     String
  rules    Json // Complex IF-THEN conditions
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DelegationWindow {
  id         String   @id @default(uuid())
  ownerId    String
  delegateId String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  isActive   Boolean  @default(true)

  owner    User @relation("DelegationOwner", fields: [ownerId], references: [id])
  delegate User @relation("DelegationDelegate", fields: [delegateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────

model Category {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tasks Task[]

  @@index([createdAt])
}

// ─────────────────────────────────────────────
// PROJECT
// ─────────────────────────────────────────────

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  ownerId     String?

  // Financial fields (Accounting Grade)
  contractValue Decimal @default(0) @db.Decimal(18, 2)
  totalBudget   Decimal @default(0) @db.Decimal(18, 2)

  // Schedule
  startDate DateTime?
  endDate   DateTime?

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner                 User?                  @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks                 Task[]
  wbsItems              WBSItem[]
  journalEntries        JournalEntry[]
  contracts             Contract[]
  purchaseOrders        PurchaseOrder[]
  approvalRequests      ApprovalRequest[]
  boqItems              BOQItem[]
  subcontracts          Subcontract[]
  inventoryTransactions InventoryTransaction[]
  siteConsumptions      SiteConsumption[]
  documents             Document[]
  activityFeeds         ActivityFeed[]

  @@index([status])
  @@index([createdAt])
  @@index([ownerId])
}

// ─────────────────────────────────────────────
// TASK
// ─────────────────────────────────────────────

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  projectId   String
  categoryId  String?
  assigneeId  String?
  dueDate     DateTime?
  priority    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  project  Project   @relation(fields: [projectId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  assignee User?     @relation(fields: [assigneeId], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// WBS
// ─────────────────────────────────────────────

model WBSItem {
  id        String  @id @default(uuid())
  projectId String
  name      String
  code      String?
  parentId  String?
  level     Int     @default(0)
  sortOrder Int     @default(0)

  budgetAmount Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project  Project   @relation(fields: [projectId], references: [id])
  parent   WBSItem?  @relation("WBSChildren", fields: [parentId], references: [id])
  children WBSItem[] @relation("WBSChildren")

  costs              CostRecord[]
  budgets            BudgetRecord[]
  revenues           Revenue[]
  invoices           Invoice[]
  purchaseOrderItems PurchaseOrderItem[]
  boqItems           BOQItem[]
  subcontractItems   SubcontractItem[]
  siteConsumptions   SiteConsumption[]

  @@index([projectId])
  @@index([parentId])
}

// ─────────────────────────────────────────────
// COST RECORD
// ─────────────────────────────────────────────

model CostRecord {
  id        String        @id @default(uuid())
  projectId String
  wbsId     String
  costType  CostType      @default(material)
  amount    Decimal       @db.Decimal(18, 2)
  quantity  Decimal       @default(1) @db.Decimal(18, 2)
  unitPrice Decimal       @default(0) @db.Decimal(18, 2)
  supplier  String?
  note      String?
  date      DateTime      @default(now())
  status    PaymentStatus @default(unpaid)
  requestId String?       @unique // Idempotency

  // Link to procurement
  purchaseOrderId String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  wbs           WBSItem        @relation(fields: [wbsId], references: [id])
  createdBy     User?          @relation("CostCreatedBy", fields: [createdById], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([projectId])
  @@index([wbsId])
  @@index([date])
}

// ─────────────────────────────────────────────
// BUDGET RECORD
// ─────────────────────────────────────────────

model BudgetRecord {
  id              String   @id @default(uuid())
  projectId       String
  wbsId           String
  costType        CostType @default(material)
  estimatedAmount Decimal  @db.Decimal(18, 2)

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  wbs       WBSItem @relation(fields: [wbsId], references: [id])
  createdBy User?   @relation("BudgetCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([wbsId])
}

// ─────────────────────────────────────────────
// REVENUE
// ─────────────────────────────────────────────

model Revenue {
  id          String        @id @default(uuid())
  projectId   String
  wbsId       String
  invoiceId   String?
  amount      Decimal       @db.Decimal(18, 2)
  date        DateTime      @default(now())
  status      PaymentStatus @default(unpaid)
  description String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  wbs       WBSItem  @relation(fields: [wbsId], references: [id])
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  createdBy User?    @relation("RevenueCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([wbsId])
}

// ─────────────────────────────────────────────
// INVOICE
// ─────────────────────────────────────────────

model Invoice {
  id              String        @id @default(uuid())
  projectId       String
  wbsId           String
  invoiceNumber   String?
  amount          Decimal       @db.Decimal(18, 2)
  issuedDate      DateTime      @default(now())
  dueDate         DateTime?
  paidAmount      Decimal       @default(0) @db.Decimal(18, 2)
  remainingAmount Decimal       @db.Decimal(18, 2)
  status          InvoiceStatus @default(DRAFT)
  note            String?

  // Construction specific
  retentionAmount   Decimal @default(0) @db.Decimal(18, 2)
  certifiedProgress Decimal @default(0) @db.Decimal(18, 2) // Progress value certified in this invoice

  requestId String? @unique // Idempotency

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  version     Int       @default(1)

  wbs       WBSItem   @relation(fields: [wbsId], references: [id])
  payments  Payment[]
  revenues  Revenue[]
  createdBy User?     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  // Link to contract
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])

  @@index([projectId])
  @@index([wbsId])
}

// ─────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────

model Payment {
  id          String    @id @default(uuid())
  invoiceId   String
  projectId   String
  amount      Decimal   @db.Decimal(18, 2)
  date        DateTime  @default(now())
  description String?
  requestId   String?   @unique // Idempotency
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([projectId])
}

// ─────────────────────────────────────────────
// ACCOUNTING (LEDGER)
// ─────────────────────────────────────────────

model LedgerAccount {
  id          String      @id @default(uuid())
  code        String      @unique // e.g. 1010 (Cash), 4010 (Revenue)
  name        String
  type        AccountType
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  lines TransactionLine[]

  @@index([code])
  @@index([type])
}

model JournalEntry {
  id          String    @id @default(uuid())
  projectId   String?
  date        DateTime  @default(now())
  description String
  reference   String? // e.g. Invoice #123
  // Source tracking: which entity triggered this entry
  sourceType  String? // e.g. "PAYMENT", "COST", "INVOICE"
  sourceId    String? // FK to the source record
  isPosted    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project Project?          @relation(fields: [projectId], references: [id])
  lines   TransactionLine[]

  @@index([projectId])
  @@index([date])
  @@index([sourceType, sourceId])
}

model TransactionLine {
  id             String          @id @default(uuid())
  journalEntryId String
  accountId      String
  amount         Decimal         @db.Decimal(18, 2)
  type           TransactionType // DEBIT or CREDIT
  description    String?

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id])
  account      LedgerAccount @relation(fields: [accountId], references: [id])
  deletedAt    DateTime?

  @@index([journalEntryId])
  @@index([accountId])
}

// ─────────────────────────────────────────────
// PROCUREMENT
// ─────────────────────────────────────────────

model PurchaseRequest {
  id          String            @id @default(uuid())
  projectId   String
  wbsId       String?
  title       String
  description String?
  requestedBy String?
  status      ProcurementStatus @default(DRAFT)
  totalAmount Decimal           @default(0) @db.Decimal(18, 2)
  requestDate DateTime          @default(now())
  neededBy    DateTime?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  createdBy      User?           @relation("PRCreatedBy", fields: [createdById], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([projectId])
  @@index([status])
}

model PurchaseOrder {
  id                String            @id @default(uuid())
  projectId         String
  purchaseRequestId String?
  poNumber          String?           @unique
  vendor            String
  description       String?
  status            ProcurementStatus @default(DRAFT)
  totalAmount       Decimal           @db.Decimal(18, 2)
  orderedDate       DateTime          @default(now())
  expectedDelivery  DateTime?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  project         Project             @relation(fields: [projectId], references: [id])
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  createdBy       User?               @relation("POCreatedBy", fields: [createdById], references: [id])
  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]
  costRecords     CostRecord[]

  @@index([projectId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String    @id @default(uuid())
  purchaseOrderId String
  wbsId           String?
  description     String
  quantity        Decimal   @db.Decimal(18, 4)
  unitPrice       Decimal   @db.Decimal(18, 2)
  amount          Decimal   @db.Decimal(18, 2)
  costType        CostType  @default(material)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  wbs           WBSItem?      @relation(fields: [wbsId], references: [id])

  @@index([purchaseOrderId])
}

model GoodsReceipt {
  id              String    @id @default(uuid())
  purchaseOrderId String
  projectId       String
  receivedDate    DateTime  @default(now())
  notes           String?
  receivedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@index([projectId])
}

// ─────────────────────────────────────────────
// CONTRACT & VARIATION
// ─────────────────────────────────────────────

model Contract {
  id             String         @id @default(uuid())
  projectId      String
  contractNumber String?        @unique
  title          String
  description    String?
  contractorName String?
  originalValue  Decimal        @db.Decimal(18, 2)
  currentValue   Decimal        @db.Decimal(18, 2)
  status         ContractStatus @default(DRAFT)
  signedDate     DateTime?
  startDate      DateTime?
  endDate        DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  project   Project          @relation(fields: [projectId], references: [id])
  createdBy User?            @relation("ContractCreatedBy", fields: [createdById], references: [id])
  changes   ContractChange[]
  invoices  Invoice[]

  @@index([projectId])
  @@index([status])
}

model ContractChange {
  id           String    @id @default(uuid())
  contractId   String
  voNumber     String? // Variation Order number
  title        String
  description  String?
  changeAmount Decimal   @db.Decimal(18, 2) // Positive = increase, Negative = decrease
  approvedDate DateTime?
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId])
}

// ─────────────────────────────────────────────
// SUBCONTRACTOR SUITE
// ─────────────────────────────────────────────

model Subcontract {
  id             String            @id @default(uuid())
  projectId      String
  contractorName String
  contractNumber String?           @unique
  title          String
  status         SubcontractStatus @default(DRAFT)

  totalValue    Decimal @default(0) @db.Decimal(18, 2)
  retentionRate Decimal @default(5) @db.Decimal(5, 2) // %

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project  Project              @relation(fields: [projectId], references: [id])
  items    SubcontractItem[]
  invoices SubcontractInvoice[]

  @@index([projectId])
  @@index([status])
}

model SubcontractItem {
  id            String  @id @default(uuid())
  subcontractId String
  wbsId         String
  description   String
  unit          String
  quantity      Decimal @db.Decimal(18, 3)
  unitRate      Decimal @db.Decimal(18, 2)
  totalAmount   Decimal @db.Decimal(18, 2)

  subcontract     Subcontract           @relation(fields: [subcontractId], references: [id])
  wbs             WBSItem               @relation(fields: [wbsId], references: [id])
  progressEntries SubcontractProgress[]

  @@index([subcontractId])
  @@index([wbsId])
}

model SubcontractProgress {
  id                String   @id @default(uuid())
  subcontractItemId String
  date              DateTime @default(now())
  quantity          Decimal  @db.Decimal(18, 3)
  amount            Decimal  @db.Decimal(18, 2)
  status            String   @default("PENDING") // PENDING, CERTIFIED, INVOICED

  subcontractItem SubcontractItem @relation(fields: [subcontractItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subcontractItemId])
  @@index([date])
}

model SubcontractInvoice {
  id              String  @id @default(uuid())
  subcontractId   String
  invoiceNumber   String?
  amount          Decimal @db.Decimal(18, 2)
  retentionAmount Decimal @db.Decimal(18, 2)
  netAmount       Decimal @db.Decimal(18, 2) // amount - retention
  status          String  @default("DRAFT")

  subcontract Subcontract @relation(fields: [subcontractId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subcontractId])
}

// ─────────────────────────────────────────────
// MATERIAL & INVENTORY SUITE
// ─────────────────────────────────────────────

model Material {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  unit        String
  description String?

  transactions InventoryTransaction[]
  consumptions SiteConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryTransaction {
  id          String                   @id @default(uuid())
  projectId   String
  materialId  String
  type        InventoryTransactionType
  quantity    Decimal                  @db.Decimal(18, 3)
  unitPrice   Decimal?                 @db.Decimal(18, 2)
  referenceId String? // PO Id or GRN Id
  note        String?

  createdAt DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@index([projectId])
  @@index([materialId])
  @@index([type])
}

model SiteConsumption {
  id         String   @id @default(uuid())
  projectId  String
  wbsId      String
  materialId String
  quantity   Decimal  @db.Decimal(18, 3)
  date       DateTime @default(now())
  note       String?

  project  Project  @relation(fields: [projectId], references: [id])
  wbs      WBSItem  @relation(fields: [wbsId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@index([projectId])
  @@index([wbsId])
  @@index([materialId])
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id       String  @id @default(uuid())
  userId   String?
  action   String // e.g. CREATE, UPDATE, DELETE, REVERSE
  entity   String // e.g. CostRecord
  entityId String
  oldData  Json?
  newData  Json?
  reason   String? // Explanation for the change

  // Tracing & Context
  severity      String  @default("INFO") // INFO, WARNING, CRITICAL
  requestId     String? // Links logs within the same HTTP request
  correlationId String? // Links logs within a long-running business process

  timestamp DateTime @default(now())
  ipAddress String?
  userAgent String?

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([timestamp])
  @@index([userId])
  @@index([requestId])
  @@index([correlationId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id          String         @id @default(uuid())
  projectId   String
  requesterId String
  entityType  String // e.g. "COST_REVERSE", "COST_OVERRUN", "PAYMENT_LARGE"
  entityId    String?
  requestData Json? // Snapshot of what is being requested
  status      ApprovalStatus @default(PENDING)
  reason      String? // Requester's reason

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project        @relation(fields: [projectId], references: [id])
  requester User           @relation("RequestRequester", fields: [requesterId], references: [id])
  steps     ApprovalStep[]

  @@index([projectId])
  @@index([requesterId])
  @@index([status])
}

model ApprovalStep {
  id                String         @id @default(uuid())
  approvalRequestId String
  approverId        String
  status            ApprovalStatus @default(PENDING)
  comment           String?
  stepOrder         Int            @default(1)

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  request  ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  approver User            @relation("StepApprover", fields: [approverId], references: [id])

  @@index([approvalRequestId])
  @@index([approverId])
}

model FiscalPeriod {
  id         String    @id @default(uuid())
  month      String    @unique // Format: YYYY-MM
  isLocked   Boolean   @default(false)
  lockedAt   DateTime?
  lockedById String?

  // Operational Snapshot
  closingBalance Decimal?  @db.Decimal(18, 2)
  reconciledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lockedBy User? @relation("PeriodLockedBy", fields: [lockedById], references: [id])

  @@index([month])
}

// ─────────────────────────────────────────────
// COLLABORATION & DOCUMENTS
// ─────────────────────────────────────────────

model Document {
  id        String @id @default(uuid())
  projectId String
  name      String
  url       String
  type      String // e.g. PDF, DRAWING, PHOTO, CONTRACT
  version   Int    @default(1)
  size      Int? // bytes

  sourceType String? // e.g. "INVOICE", "WBS", "PROGRESS"
  sourceId   String?

  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  project    Project @relation(fields: [projectId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([sourceType, sourceId])
}

model ActivityFeed {
  id         String @id @default(uuid())
  projectId  String
  userId     String
  action     String // e.g. CREATED, UPDATED, APPROVED
  entityType String // e.g. ProgressEntry
  entityId   String
  message    String
  metadata   Json?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([createdAt])
}

model Comment {
  id         String @id @default(uuid())
  userId     String
  entityType String
  entityId   String
  content    String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────
// CONSTRUCTION CORE: BOQ & PROGRESS
// ─────────────────────────────────────────────

model BOQItem {
  id          String  @id @default(uuid())
  projectId   String
  wbsId       String
  description String
  unit        String // m2, m3, kg, ton, etc.
  quantity    Decimal @db.Decimal(18, 3)
  unitRate    Decimal @db.Decimal(18, 2)
  totalAmount Decimal @db.Decimal(18, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project         Project         @relation(fields: [projectId], references: [id])
  wbs             WBSItem         @relation(fields: [wbsId], references: [id])
  progressEntries ProgressEntry[]

  @@index([projectId])
  @@index([wbsId])
}

model ProgressEntry {
  id          String   @id @default(uuid())
  boqItemId   String
  date        DateTime @default(now())
  quantity    Decimal  @db.Decimal(18, 3) // Quantity completed in this entry
  amount      Decimal  @db.Decimal(18, 2) // Value = quantity * unitRate
  createdById String
  note        String?

  status String @default("PENDING") // PENDING, VERIFIED, INVOICED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boqItem      BOQItem       @relation(fields: [boqItemId], references: [id])
  measurements Measurement[]
  createdBy    User          @relation("ProgressCreatedBy", fields: [createdById], references: [id])

  @@index([boqItemId])
  @@index([date])
}

model Measurement {
  id              String   @id @default(uuid())
  progressEntryId String
  description     String?
  length          Decimal? @db.Decimal(18, 3)
  width           Decimal? @db.Decimal(18, 3)
  height          Decimal? @db.Decimal(18, 3)
  factor          Decimal  @default(1) @db.Decimal(18, 3) // e.g. number of columns
  quantity        Decimal  @db.Decimal(18, 3) // length * width * height * factor

  progressEntry ProgressEntry @relation(fields: [progressEntryId], references: [id])

  @@index([progressEntryId])
}
